# .env.example
# 이 파일을 복사하여 .env 파일을 만들고 각 값을 입력하세요.
# cp .env.example .env

# ============================================
# Anthropic Claude API
# ============================================
# https://console.anthropic.com에서 API 키 발급
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# FRED API (경제지표)
# ============================================
# https://fred.stlouisfed.org에서 무료 가입
# API 키: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ============================================
# NewsAPI (뉴스)
# ============================================
# https://newsapi.org에서 무료 플랜 가입
NEWSAPI_KEY=your_newsapi_key_here

# ============================================
# 선택사항: 알림 채널 (향후 구현)
# ============================================
# Telegram Bot
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# KakaoTalk (Flask 서버 필요)
# KAKAO_ACCESS_TOKEN=your_kakao_access_token

# Email
# EMAIL_SENDER=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password
# EMAIL_RECIPIENT=target_email@gmail.com

# ============================================
# 로컬 경로 설정 (새 Mac 이식 시 필요할 수 있음)
# ============================================
# Google Drive xlsx 경로 (비워두면 자동 탐색)
# Google Drive 미연결이거나 경로가 다를 경우 직접 지정
# GOOGLE_DRIVE_XLSX_PATH=~/Library/CloudStorage/GoogleDrive-your@gmail.com/내 드라이브/PF/자산계산기(클로드).xlsx

# gspread credentials.json 경로 (기본값: ~/.config/gspread/credentials.json)
# GSPREAD_CREDENTIALS_PATH=~/.config/gspread/credentials.json

# ============================================
# Google Sheets 연동 (권장)
# ============================================
# Google Sheets 문서 ID (비워두면 .gsheet 파일 자동 탐색 → 하드코딩 fallback 순)
GOOGLE_SHEET_ID=
# Google Sheets 스프레드시트 이름 (.gsheet 바로가기 파일명 매칭 + 이름으로 열기 fallback)
GOOGLE_SHEET_NAME=자산계산기(클로드)
# Google Drive xlsx 경로 (실제 .xlsx가 있을 때만 사용, .gsheet만 있으면 불필요)
GOOGLE_DRIVE_XLSX_PATH=
